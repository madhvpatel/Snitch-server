# Pasteable backend env for Render/Railway.
# Replace every <...> value before deploy. Do not commit a filled copy.

NODE_ENV=production
PORT=3001

# Persistence
SNITCH_STORE_DRIVER=supabase
DATABASE_URL=postgresql://postgres.acikodtgtcfkebhrjjjb:<ROTATED_SUPABASE_PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# Use this only if the host provides a persistent disk/volume.
# Render/Railway recommended mount path:
SNITCH_DATA_DIR=/var/data/snitch

# Auth/secrets. Generate long random values.
PORTAL_JWT_SECRET=<64_CHAR_RANDOM_SECRET>
MOBILE_JWT_SECRET=<64_CHAR_RANDOM_SECRET>
IP_HASH_SALT=<64_CHAR_RANDOM_SECRET>
SNITCH_DEMO_PASSWORD=<STRONG_ADMIN_DEMO_PASSWORD>

# API providers
ACRCLOUD_HOST=<ACRCLOUD_HOST>
ACRCLOUD_ACCESS_KEY=<ACRCLOUD_ACCESS_KEY>
ACRCLOUD_ACCESS_SECRET=<ACRCLOUD_ACCESS_SECRET>
FOURSQUARE_SERVICE_KEY=<FOURSQUARE_SERVICE_KEY>
GOOGLE_PLACES_API_KEY=<GOOGLE_PLACES_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-flash-latest

# Runtime integrations
FFMPEG_PATH=ffmpeg
PYTHON_AI_BASE_URL=<PYTHON_AI_SERVICE_URL_OR_LEAVE_LOCAL_DISABLED>
DEMO_FORCE_SIGNATURE_VERIFIED=false

# Comma-separated browser/mobile web origins allowed to call the API.
# Example:
# ALLOWED_ORIGIN=https://snitch-crm-1.vercel.app,https://snitch-mobile-beta.vercel.app
ALLOWED_ORIGIN=<CRM_URL>,<MOBILE_WEB_URL>
